# Copier en .env (chmod 600) et adapter. Aucune valeur ici n'est un vrai secret.

# Obligatoire en production : clé aléatoire longue.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GU_SECRET_KEY=

# development | production
GU_ENV=production

# Chemin de la base SQLite (le dossier doit exister et appartenir à l'utilisateur système).
GU_DATABASE_PATH=/var/lib/game-update/game_update.sqlite3
GU_BACKUP_DIR=/var/lib/game-update/backups
GU_BACKUP_KEEP=14

# Fuseau horaire d'affichage des dates.
GU_TIMEZONE=Europe/Paris

# Niveau de log : DEBUG, INFO, WARNING, ERROR
GU_LOG_LEVEL=INFO

# URL publique de l'application (lien dans les notifications).
GU_BASE_URL=https://game-update.example.ts.net

# Authentification HTTP Basic (optionnelle si l'accès se fait uniquement via Tailscale).
# Générer le hash : python -c "from werkzeug.security import generate_password_hash as g; print(g('motdepasse'))"
GU_BASIC_AUTH_USER=
GU_BASIC_AUTH_PASSWORD_HASH=

# Nombre de proxys de confiance devant l'app (Caddy/nginx/tailscale serve = 1).
GU_TRUSTED_PROXIES=1

# Collecte
GU_USER_AGENT="GameUpdateBot/0.1 (+https://game-update.example.ts.net; contact: admin@example.com)"
GU_HTTP_TIMEOUT=20
GU_HTTP_MIN_INTERVAL=5
GU_DEFAULT_FETCH_INTERVAL=3600
GU_MAX_BACKOFF=86400

# Notifications : ntfy | log | none
GU_NOTIFIER=ntfy
GU_NTFY_SERVER=https://ntfy.sh
GU_NTFY_TOPIC=
# Jeton d'accès si le sujet ntfy est protégé (recommandé).
GU_NTFY_TOKEN=
